# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cheapest capable model for short structured check-ins.
# Swap to a newer Flash-Lite model name if this one is retired.
GEMINI_MODEL=gemini-3.5-flash-lite

# VAPID keys for web push — generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Server port
PORT=3000

# How often the scheduler scans for critical points (minutes)
SCAN_INTERVAL_MINUTES=10

# Grace period after a task's end time before it counts as "overrun" (minutes)
OVERRUN_GRACE_MINUTES=15

# Don't re-check-in on the same task more often than this (minutes)
CHECKIN_COOLDOWN_MINUTES=60

# Fraction through the working day (0-1) at which we check overall drift
MIDDAY_CHECK_FRACTION=0.5

# If completion rate is below this fraction at the midday check, fire a drift check-in
MIDDAY_COMPLETION_THRESHOLD=0.4

# Working day window, 24h format, used to compute "day elapsed" fraction
DAY_START_HOUR=9
DAY_END_HOUR=18

DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "false" only if connecting to a local Postgres with no SSL configured.
# Leave unset (defaults to SSL-enabled-but-unverified) for hosted providers.
DATABASE_SSL=
# cookies "secure" (HTTPS-only). Keep unset for local http:// testing.
NODE_ENV=

# Secret used to sign session tokens — use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=